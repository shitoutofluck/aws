# ============================================================================
# Autonomous Multi-LLM Orchestration System - Environment Configuration
# ============================================================================
#
# Copy this file to .env and fill in your actual values
# Command: cp .env.example .env
#

# ============================================================================
# API KEYS (Required)
# ============================================================================

# Anthropic API Key for Claude 3.5 Sonnet (Planner Agent)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# xAI API Key for Grok (Computer Control Agent)
# Get your key at: https://x.ai/
XAI_API_KEY=xai-your-key-here

# DeepSeek API Key (Optional - only needed if using API mode instead of local)
# DEEPSEEK_API_KEY=your-key-here

# ============================================================================
# LLM CONFIGURATION
# ============================================================================

# DeepSeek deployment mode: "local" (via Ollama) or "api"
# Recommended: local (fully offline after initial setup)
DEEPSEEK_MODE=local

# DeepSeek model name (for Ollama)
# Default: deepseek-r1:8b
# Other options: deepseek-r1:1.5b, deepseek-r1:14b, deepseek-r1:32b
DEEPSEEK_MODEL=deepseek-r1:8b

# Claude model version
# Default: claude-3-5-sonnet-20241022
# Other options: claude-3-5-sonnet-20240620, claude-3-opus-20240229
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Grok model version
# Default: grok-beta
GROK_MODEL=grok-beta

# ============================================================================
# OLLAMA CONFIGURATION
# ============================================================================

# Ollama base URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================================
# XAI CONFIGURATION
# ============================================================================

# xAI API base URL (default: https://api.x.ai/v1)
XAI_BASE_URL=https://api.x.ai/v1

# ============================================================================
# SAFETY CONFIGURATION
# ============================================================================

# Safety mode: "strict" (default) or "permissive"
#
# strict mode:
#   - Blocks dangerous commands (rm, del, format, shutdown, etc.)
#   - Only allows whitelisted applications
#   - Requires confirmations for file modifications
#   - Recommended for all untrusted tasks
#
# permissive mode:
#   - Relaxed app restrictions
#   - Still blocks system-level dangerous commands
#   - Use ONLY when you fully trust the task
#
SAFETY_MODE=strict

# Require user confirmation for destructive actions (true/false)
REQUIRE_CONFIRMATION=true

# Action timeout in seconds (1-300)
# Maximum time allowed for a single operation
ACTION_TIMEOUT=30

# Screenshot logging (true/false)
# Captures before/after screenshots of all actions for audit trails
SCREENSHOT_LOGGING=true

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG: Verbose logging for troubleshooting
# INFO: Standard operational logging (recommended)
# WARNING: Only warnings and errors
LOG_LEVEL=INFO

# Maximum retry attempts for failed operations
MAX_RETRIES=3

# Retry delay in seconds (exponential backoff multiplier)
RETRY_DELAY=1.0

# ============================================================================
# COMPUTER CONTROL LIMITS
# ============================================================================

# Maximum screen dimensions for coordinate validation
# Coordinates will be clamped to these values
# Adjust if you have a larger display
MAX_SCREEN_WIDTH=3840
MAX_SCREEN_HEIGHT=2160

# ============================================================================
# NOTES
# ============================================================================
#
# 1. NEVER commit the .env file to version control (it contains secrets)
# 2. The .env file is already in .gitignore
# 3. All values are validated on startup - you'll get clear error messages
# 4. Boolean values: true/false (lowercase)
# 5. Numeric values: no quotes needed
# 6. String values: no quotes needed (unless they contain spaces)
#
# For more information, see README.md
#

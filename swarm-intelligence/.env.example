# ============================================================================
# Swarm Intelligence Simulation Engine - Environment Configuration
# ============================================================================
# Copy to .env and fill in values: cp .env.example .env
#
# IMPORTANT: All API keys are OPTIONAL. The system works fully offline
# with Ollama (DeepSeek local mode) -- no API costs required.

# ============================================================================
# API KEYS (All Optional)
# ============================================================================

# Anthropic API Key for Claude (best for planning/reporting)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# xAI API Key for Grok (alternative LLM)
# XAI_API_KEY=xai-your-key-here

# DeepSeek API Key (only if using API mode instead of local Ollama)
# DEEPSEEK_API_KEY=your-key-here

# ============================================================================
# LLM CONFIGURATION
# ============================================================================

# DeepSeek mode: "local" (Ollama, free) or "api"
DEEPSEEK_MODE=local

# Model names
DEEPSEEK_MODEL=deepseek-r1:8b
CLAUDE_MODEL=claude-3-5-sonnet-20241022
GROK_MODEL=grok-beta

# Ollama URL
OLLAMA_BASE_URL=http://localhost:11434

# xAI URL
XAI_BASE_URL=https://api.x.ai/v1

# ============================================================================
# SIMULATION CONFIGURATION
# ============================================================================

# Simulation mode: "llm" (rich, slower), "rule" (fast, free), "hybrid"
SIMULATION_MODE=hybrid

# Agent generation
MAX_AGENTS=20
MIN_AGENTS=5
USE_LLM_FOR_BIOS=true

# Simulation rounds
MAX_ROUNDS=10

# Text processing for GraphRAG
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ============================================================================
# MEMORY CONFIGURATION
# ============================================================================

# Where to store agent memories
MEMORY_STORAGE_DIR=data/memory
MAX_MEMORY_ENTRIES=100

# ============================================================================
# APPLICATION
# ============================================================================

LOG_LEVEL=INFO
MAX_RETRIES=3
DATA_DIR=data
